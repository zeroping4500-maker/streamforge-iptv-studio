# ZEMYIPTV configuration — copy to .env (gitignored) or set on the host.

# Neon Postgres (required). Use the pooled connection string for app traffic.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Auth (required for /admin). Base URL is the project's auth endpoint.
# NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
# NEON_AUTH_APP_NAME=holy-dawn-31979762

# Optional: override the accepted JWT issuer (comma separated) if Neon changes it.
# NEON_AUTH_ISSUER=

# Optional: admin session lifetime in seconds (default 12 hours).
# ZEMY_ADMIN_SESSION_TTL=43200

# Optional: Postgres pool size (default 1..8 per process).
# PG_POOL_MIN=1
# PG_POOL_MAX=8

# Optional: runtime port (Render sets this itself).
# PORT=8080
